file                =  { SOI ~ blocks ~ newline? ~ EOI }
single_line         =  { SOI ~ block ~ EOI }
// Entry point for the line fast path (stage-1 triage): a copy of the program
// in which only the lines that need the grammar keep their text and every
// other line is empty. Blank runs are consumed by `newline+` without
// producing a block, so the pairs are exactly the grammar-bound lines in
// order, at their whole-file positions. The buffer always ends in a newline.
sparse_lines        =  { SOI ~ newline* ~ (block ~ newline+)* ~ EOI }
// Entry points of the statement-AST executor (NC_EXEC=ast): one line on its
// own, or the sparse copy of the program over line_block (see sparse_lines).
line                =  { SOI ~ line_block ~ EOI }
sparse_line_blocks  =  { SOI ~ newline* ~ (line_block ~ newline+)* ~ EOI }
blocks              =  { block ~ (newline ~ block)* }
newline             = _{ "\n" | "\r\n" }
WHITESPACE          = _{ " " | "\t" }
QUOTE               = _{ "\"" }
// Atomic: without @ pest would attempt the implicit WHITESPACE rule between
// every single character of the comment body, which measurably dominates
// comment-heavy files.
comment             = @{ ";" ~ (!newline ~ ANY)* }
// Alternatives are ordered for parse speed on coordinate-flood programs:
// statements are tried before control, which is safe because every control
// keyword (IF, GOTO.., CASE, LOOP, FOR, WHILE, REPEAT) is in `reserved` and
// therefore can never parse as a statement. definition and frame_op must
// stay in front: DEF/TRANS/... are not reserved words, so a statement would
// otherwise swallow them as function calls or assignments.
block               =  { block_number_set? ~ (label_def ~ !structure_line_kw)? ~ ((definition | frame_op | statement+ | control) ~ !body_end_kw)? ~ comment? }
// A block with a control-structure keyword carries no label (alarm 12630); a
// conditional jump (IF ... GOTO) is no structure and keeps its label.
structure_line_kw   = _{ body_end_kw | structure_head_kw | (block_if_kw ~ condition ~ comment? ~ (newline | EOI)) }
structure_head_kw   = @{ (^"WHILE" | ^"FOR" | ^"LOOP" | ^"REPEAT") ~ !(ASCII_ALPHANUMERIC | "_") }
block_if_kw         = @{ ^"IF" ~ !(ASCII_ALPHANUMERIC | "_") }
// A body ends only at a line that starts with ELSE or a closer: a closer
// after other content (`X1 ENDIF`, `X1 ELSE X2`) must not end the body.
body_end_kw         = @{ (^"ELSE" | ^"ENDIF" | ^"ENDWHILE" | ^"ENDFOR" | ^"ENDLOOP" | ^"UNTIL") ~ !(ASCII_ALPHANUMERIC | "_") }
// A structure head is alone on its line (manual 4.1.7); only a comment may
// follow it, and that comment parses as the first body block.
head_end            = _{ &(comment? ~ newline) }
// `block` with line_control in place of control: a multi-line structure is
// seen as its head, ELSE and closer lines, so a line_block never spans a newline.
line_block          =  { block_number_set? ~ (label_def ~ !structure_line_kw)? ~ ((definition | frame_op | statement+ | line_control) ~ !body_end_kw)? ~ comment? }
block_number_set    = _{ "N" ~ block_number }
control             =  {
    gotos_statement
  | goto_statement
  | case_statement
  | if_goto_statement+
  | if_statement
  | loop_statement
  | for_statement
  | while_statement
  | repeat_until_statement
}
// Jump labels sit at the start of a block, immediately after the block
// number if there is one (manual 4.1.5.2): 2..32 characters, the first two
// being letters or underscores, terminated by a colon. Compound-atomic so
// no whitespace may separate the name from the colon.
label_def  = ${ label_name ~ ":" }
label_name = @{ (ASCII_ALPHA | "_"){2} ~ (ASCII_ALPHANUMERIC | "_"){0, 30} }
// GOTO targets are labels or block numbers. The keyword is atomic with a
// word boundary so that identifiers like GOTOFFSET still parse as ordinary
// names. GOTOS (return jump to program start) takes no target.
goto_statement         =  { goto_kw ~ goto_target }
goto_kw                = @{ (^"GOTOC" | ^"GOTOF" | ^"GOTOB" | ^"GOTO") ~ !(ASCII_ALPHANUMERIC | "_") }
gotos_statement        = @{ ^"GOTOS" ~ !(ASCII_ALPHANUMERIC | "_") }
goto_target            =  { identifier | block_number }
// Conditional jump in a single block: IF <condition> GOTO... <target>.
// Several conditional jumps may share one block (manual 4.1.5.2).
if_goto_statement      =  { ^"IF" ~ condition ~ goto_statement }
// Program branch: CASE(<expr>) OF <const> GOTO... <target> ... DEFAULT ...
// (manual 4.1.5.3). Without a DEFAULT arm, execution falls through to the
// next block when no constant matches.
case_statement         =  { case_kw ~ expression ~ of_kw ~ case_arm+ ~ case_default? }
case_kw                = @{ ^"CASE" ~ !(ASCII_ALPHANUMERIC | "_") }
of_kw                  = @{ ^"OF" ~ !(ASCII_ALPHANUMERIC | "_") }
case_arm               =  { value ~ goto_statement }
case_default           =  { default_kw ~ goto_statement }
default_kw             = @{ ^"DEFAULT" ~ !(ASCII_ALPHANUMERIC | "_") }
if_statement           =  { ^"IF" ~ condition ~ comment? ~ newline ~ blocks ~ (^"ELSE" ~ head_end ~ blocks)? ~ ^"ENDIF" }
loop_statement         =  { ^"LOOP" ~ head_end ~ blocks ~ ^"ENDLOOP" }
for_statement          =  { ^"FOR" ~ assignment ~ ^"TO" ~ expression ~ head_end ~ blocks ~ ^"ENDFOR" }
while_statement        =  { ^"WHILE" ~ condition ~ head_end ~ blocks ~ ^"ENDWHILE" }
repeat_until_statement =  { ^"REPEAT" ~ head_end ~ blocks ~ ^"UNTIL" ~ condition }
// The single-line forms of `control`, then the line-level forms of the
// structures (last, so a jump line never tries them). The multi-line rules
// are left out: in a sparse buffer they would swallow the following lines.
line_control           =  {
    gotos_statement
  | goto_statement
  | case_statement
  | if_goto_statement+
  | if_head
  | else_kw
  | endif_kw
  | while_head
  | endwhile_kw
  | for_head
  | endfor_kw
  | repeat_kw
  | until_tail
  | loop_kw
  | endloop_kw
}
// The !goto_kw guard keeps a conditional jump with a bad target from
// parsing as the head of an IF block.
if_head                =  { if_kw ~ condition ~ !goto_kw }
while_head             =  { while_kw ~ condition }
// TO is unbounded as in for_statement, so both accept the same text.
for_head               =  { for_kw ~ assignment ~ ^"TO" ~ expression }
until_tail             =  { until_kw ~ condition }
if_kw                  = @{ ^"IF" ~ !(ASCII_ALPHANUMERIC | "_") }
while_kw               = @{ ^"WHILE" ~ !(ASCII_ALPHANUMERIC | "_") }
for_kw                 = @{ ^"FOR" ~ !(ASCII_ALPHANUMERIC | "_") }
until_kw               = @{ ^"UNTIL" ~ !(ASCII_ALPHANUMERIC | "_") }
else_kw                = @{ ^"ELSE" ~ !(ASCII_ALPHANUMERIC | "_") }
endif_kw               = @{ ^"ENDIF" ~ !(ASCII_ALPHANUMERIC | "_") }
endwhile_kw            = @{ ^"ENDWHILE" ~ !(ASCII_ALPHANUMERIC | "_") }
endfor_kw              = @{ ^"ENDFOR" ~ !(ASCII_ALPHANUMERIC | "_") }
repeat_kw              = @{ ^"REPEAT" ~ !(ASCII_ALPHANUMERIC | "_") }
loop_kw                = @{ ^"LOOP" ~ !(ASCII_ALPHANUMERIC | "_") }
endloop_kw             = @{ ^"ENDLOOP" ~ !(ASCII_ALPHANUMERIC | "_") }
block_number           =  { integer }
// A condition is just an expression: comparison and logic operators are
// expression operators (manual 4.1.3.3 "Priority of the operations"), so
// forms like `(A == 1 AND B == 1)` and `R11 = R10 >= 100` parse uniformly.
condition              =  { expression }
relational_operator    =  { "<=" | ">=" | "==" | "<>" | "<" | ">" }
statement              =  {
    axis_word
  | g_command_numbered
  | m_command
  | tool_selection
  | assignment_multi
  | assignment
  | g_command
  | non_returning_function_call
}
// Fast path for the by-far most common statement in real programs: a bare
// axis word like `X123.456`. Semantically identical to the first alternative
// of `assignment`, but hoisted above `assignment_multi` so that flood lines
// of coordinates skip the identifier rule (whose reserved-word lookahead
// tries ~19 case-insensitive keywords) entirely - that lookahead dominated
// the parse profile. The `!"["` guard keeps arrays whose name happens to
// look like an axis word (e.g. `X1[2]=...`) flowing to assignment_multi.
axis_word              =  { variable_single_char ~ value ~ !"[" }

// local variable definitions
definition = { ^"DEF" ~ data_type ~ (assignment_multi | assignment | variable_array | variable) ~ ("," ~ (assignment_multi | assignment | variable_array | variable))* }
data_type  = { ^"INT" | ^"REAL" | ^"BOOL" | (^"STRING" ~ "[" ~ ASCII_DIGIT+ ~ "]") }

// basic math expression interpreter
expression =  { prefix* ~ primary ~ (op ~ prefix* ~ primary)* }
reserved   = _{
    ^"IF"
  | ^"ELSE"
  | ^"ENDIF"
  // Longest first: PEG choice commits, so GOTO would shadow GOTOB/GOTOF/
  // GOTOC/GOTOS (the boundary check then fails without retrying).
  | ^"GOTOB"
  | ^"GOTOF"
  | ^"GOTOC"
  | ^"GOTOS"
  | ^"GOTO"
  | ^"CASE"
  | ^"OF"
  | ^"DEFAULT"
  | ^"LOOP"
  | ^"FOR"
  | ^"WHILE"
  | ^"REPEAT"
  | ^"LABEL"
  | ^"TO"
  | ^"UNTIL"
  | ^"ENDWHILE"
  | ^"ENDFOR"
  | ^"ENDLOOP"
}

// Sinumerik user variables may begin with an underscore: CAM post-processors
// routinely emit `_`-prefixed temporaries (e.g. `_WITH_M0`). The first
// character is a letter or underscore; the rest are alphanumeric/underscore.
identifier = @{
    !(reserved ~ !(ASCII_ALPHANUMERIC | "_"))
    ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")*
}

variable             =  { (nc_variable | identifier) }
// Case-insensitive: the language ignores case, and a lowercase x100 falling
// through to the subprogram-call rule silently loses the move.
variable_single_char = @{
    ^"X" | ^"Y" | ^"Z"
  | ^"A" | ^"B" | ^"C"
  | ^"U" | ^"V" | ^"W"
  | ^"I" | ^"J" | ^"K"
  | ^"T" | ^"S" | ^"F"
  | ^"D" | ^"H" | ^"E"
}

// must be an axis
variable_array = { (nc_variable | identifier) ~ "[" ~ indices ~ "]" }
indices        = { expression ~ ("," ~ expression)* }
assignment     = {
    (variable_single_char ~ value) // variable must be an axis

  // The variable may be an axis or a normal variable; sorted out after parsing.
  // One rule for every right-hand side (expression, quoted string, << chain)
  // so it is parsed once: separate alternatives parsed it twice (#78).
  | (variable ~ "=" ~ (axis_increment | string_expression))

  // Never an axis: a numeric or string element, or the single-character write
  // STRING[<index>] = "<char>" (manual 4.1.4.8).
  | (variable_array ~ "=" ~ string_expression)
}
axis_increment = { ^"IC" ~ "(" ~ expression ~ ")" }
// A quoted string. Compound-atomic ($): no implicit WHITESPACE is skipped
// between the quotes, so a string that is only spaces (e.g. " ", searched for
// by INDEX in real date-formatting code) keeps its content instead of being
// eaten by the WHITESPACE rule. The inner `string` pair still surfaces.
string_value   = ${ QUOTE ~ string ~ QUOTE }
// An operand with zero or more `<<` links (manual 4.1.4). The link operator
// joins quoted strings, STRING variables, SPRINT/SUBSTR results and numbers
// (converted to text); it is not an expression operator, so `expression`
// stops at the next `<<`. Zero links are allowed so an operand is parsed
// once (the interpreter unwraps a lone one): trying a chain before a plain
// expression parsed every operand twice, 4^n for nested calls (#78).
// A missing left operand (`<< X`) is the implicit conversion to STRING
// (manual 4.1.4.1), as in `MATCH(STR, <<NAME)`.
string_expression = { (concat_operand ~ ("<<" ~ concat_operand)*) | ("<<" ~ concat_operand)+ }
concat_operand    = { string_value | expression }

assignment_multi =  { variable_array ~ "=" ~ (value_array | value_repeating) }
value_array      =  { "SET" ~ "(" ~ (expression | value_none) ~ ("," ~ (expression | value_none))* ~ ")" }
value_repeating  =  { "REP" ~ "(" ~ expression ~ ("," ~ expression)? ~ ")" }
value_none       =  { "" }
// Atomic: the interpreter only reads the full lexeme (as_str), so the inner
// float/integer pairs would be two dead tokens per coordinate on the queue.
value            = @{ float | integer }
op               = _{
    op_add | op_sub | op_mul | op_div | op_int_div | op_mod
  | op_b_and | op_b_xor | op_b_or
  | op_and | op_xor | op_or
  | relational_operator
}
op_add           =  { "+" }
op_sub           =  { "-" }
op_mul           =  { "*" }
op_div           =  { "/" }
// Word-bounded like the logic operators: DIVISOR / MODAL in an expression
// must stay identifiers, not tokenize as DIV/MOD plus a trailing name.
op_int_div       = @{ ^"DIV" ~ !(ASCII_ALPHANUMERIC | "_") }
op_mod           = @{ ^"MOD" ~ !(ASCII_ALPHANUMERIC | "_") }
// Logic and bit-by-bit operators (manual 4.1.3.2); word-bounded so
// identifiers like ANDGATE or ORIGIN never match an operator. B_* first:
// they must not be shadowed by a bare variable read of `B_AND`.
op_b_and         = @{ ^"B_AND" ~ !(ASCII_ALPHANUMERIC | "_") }
op_b_xor         = @{ ^"B_XOR" ~ !(ASCII_ALPHANUMERIC | "_") }
op_b_or          = @{ ^"B_OR" ~ !(ASCII_ALPHANUMERIC | "_") }
op_and           = @{ ^"AND" ~ !(ASCII_ALPHANUMERIC | "_") }
op_xor           = @{ ^"XOR" ~ !(ASCII_ALPHANUMERIC | "_") }
op_or            = @{ ^"OR" ~ !(ASCII_ALPHANUMERIC | "_") }
prefix           = _{ neg | not_op }
neg              =  { "-" }
// Logical negation (unary, binds like unary minus). The word boundary keeps
// identifiers such as NOTCH out of the operator rule; prefixes are tried
// before `primary`, so a bare NOT never parses as a variable read.
not_op           = @{ ^"NOT" ~ !(ASCII_ALPHANUMERIC | "_") }
primary          =  { arith_fun | value | variable_array | variable | "(" ~ expression ~ ")" }
float            = @{ "-"? ~ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT* ~ !ASCII_ALPHA } // Ensure floats are not followed by letters
integer          = @{ "-"? ~ ASCII_DIGIT+ ~ !ASCII_ALPHA } // Ensure integers are not followed by letters
// Any call-shaped name is accepted here; the interpreter dispatches on the
// (case-insensitive) name and rejects unknown functions with line context.
// Keeping the vocabulary out of the grammar means adding a function is a
// one-place change and a typo'd name gets a clear runtime error instead of
// a confusing parse failure.
arith_fun        = { arith_fun_name ~ "(" ~ function_arguments ~ ")" }
arith_fun_name   = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }

tool_selection = { ^"T" ~ "=" ~ string_value }

// Frame instructions. A single rule captures the whole family (with any
// number of axis assignments, including none: a bare substituting frame
// instruction like `TRANS` resets the frame component). The keyword is
// atomic so that identifiers such as TRANSFORM cannot half-match.
frame_op = { frame_kw ~ assignment* }
frame_kw = @{
    (^"AMIRROR" | ^"AROTS" | ^"AROT" | ^"ASCALE" | ^"ATRANS" | ^"CROTS" | ^"MIRROR" | ^"ROTS" | ^"ROT" | ^"SCALE" | ^"TRANS") ~ !(ASCII_ALPHANUMERIC | "_")
}

// function call parser
non_returning_function_call =  { identifier ~ ("(" ~ function_arguments? ~ ")")? }
// Arguments may be left empty (`CYCLE(1,,3)`) except the last one. Each one
// is parsed once: `(argument? ~ ",")* ~ argument` parsed the last argument
// twice, doubling the work at every nesting level (#78).
function_arguments          =  { ","* ~ function_argument ~ ("," ~ ","* ~ function_argument)* }
// An expression, a quoted string or a `<<` concatenation (see string_expression).
function_argument           = _{ string_expression }
// Atomic body: a maximal run of non-quote characters, taken verbatim with no
// WHITESPACE skipping (may be empty for ""). Its quote wrapper (string_value)
// is compound-atomic, so leading/trailing/only-whitespace content survives.
string                      = @{ (!"\"" ~ ANY)* }

// builtins, globally available names
nc_variable = { "$" ~ identifier }

m_command = { ^"M" ~ ASCII_DIGIT+ }

// G commands are recognized by lexical shape only: `G<digits>` and the
// grinding-frame form `GFRAME[<n>]`. Membership in the G vocabulary - and
// the G group each command belongs to - lives in a Rust table generated
// from ggroups.json (src/modal_groups.rs); unknown G numbers are rejected
// by the interpreter (alarm 12470 on a real control). Keyword-shaped
// commands (POLY, BSPLINE, SOFT, ...) parse as ordinary identifiers via
// non_returning_function_call and are reclassified against the same table.
g_command_numbered =  { &("G" ~ ASCII_DIGIT+) ~ g_command }
// Both forms enforce a word boundary so e.g. `G1X10` and `GFRAME[2]X10`
// require a separator, like the gg-group rules they replaced.
g_command          = @{ (^"GFRAME[" ~ ASCII_DIGIT+ ~ "]" ~ !(ASCII_ALPHANUMERIC | "_")) | (^"G" ~ ASCII_DIGIT+ ~ !(ASCII_ALPHANUMERIC | "_")) }
